{
  "name": "proxymanager-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "import:substore": "tsx --env-file=.env.local scripts/import-from-substore.ts",
    "migrate:rules": "tsx --env-file=.env.local scripts/migrate-rules-into-hash.ts",
    "migrate:providers": "tsx --env-file=.env.local scripts/migrate-providers-into-hash.ts",
    "dedupe:rules": "tsx --env-file=.env.local scripts/dedupe-rules.ts",
    "fix:substore-dedup": "tsx --env-file=.env.local scripts/fix-sub-store-dedup.ts",
    "init:default-profile": "tsx --env-file=.env.local scripts/init-default-profile.ts",
    "recategorize:proxy-groups": "tsx --env-file=.env.local scripts/recategorize-proxy-groups.ts",
    "migrate:profile-source": "tsx --env-file=.env.local scripts/migrate-profile-source.ts",
    "migrate:rule-set-content": "tsx --env-file=.env.local scripts/migrate-rule-set-content.ts",
    "migrate:collection-slug": "tsx --env-file=.env.local scripts/migrate-collection-slug.ts",
    "migrate:config-per-profile": "tsx --env-file=.env.local scripts/migrate-config-per-profile.ts",
    "migrate:profile-kind": "tsx --env-file=.env.local scripts/migrate-profile-kind.ts",
    "migrate:tailscale-device": "tsx --env-file=.env.local scripts/migrate-tailscale-device.ts",
    "vercel:dev": "vercel dev",
    "vercel:link": "vercel link",
    "vercel:deploy": "vercel deploy",
    "vercel:deploy:prod": "vercel deploy --prod",
    "vercel:env:pull": "vercel env pull .env.local",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "@upstash/redis": "^1.38.0",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "redos-detector": "6.1.4",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0",
